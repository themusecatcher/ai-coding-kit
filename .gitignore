# ============================================================
# ai-coding-kit .gitignore
# 说明：本仓库为资源仓库（skills/agents/rules），运行时数据都在
# ~/.codebuddy/ 根级，不会进入本仓库，故无需为其配置忽略规则。
# 这里只保留真正可能出现在仓库内的：OS 文件、编辑器临时文件、备份目录。
# ============================================================

# ---- OS / 系统临时文件 ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---- 编辑器 / IDE ----
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ---- 安装器备份目录（sync 未排除，可能被带入仓库）----
**/.backup/

# ---- Playwright MCP 运行时快照 ----
.playwright-mcp/

# ---- 非 pnpm 的 lock 文件（本仓库统一使用 pnpm）----
package-lock.json
yarn.lock

# ---- 文档站（VitePress）----
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
# VitePress 编译 config 时产生的临时文件
docs/.vitepress/*.timestamp-*.mjs
# 脚本生成的侧边栏（构建时自动生成，无需入库）
docs/.vitepress/sidebar.generated.mjs
# gen-docs.mjs 投影生成的内容目录（构建产物，单一权威源在 skills/ rules/ agents/）
# 手写页面 docs/index.md 与 docs/guide/ 不忽略
docs/skills/
docs/rules/
docs/agents/
docs/dev-flow/
